{
  "name": "lending-app",
  "version": "1.0.0",
  "description": "Lending platform with React frontend and PHP backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run api-server\" \"vite\"",
    "api-server": "node api-server.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest --run",
    "format:fix": "prettier --write .",
    "typecheck": "tsc",
    "generate:android-icons": "bash update-android-icons.sh",
    "native:build": "npm run generate:android-icons && npm run build && npx cap sync",
    "native:android": "npm run native:build && npx cap run android",
    "native:ios": "npm run native:build && npx cap run ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/cli": "^7.6.5",
    "@capacitor/core": "^8.3.4",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "better-sqlite3": "^11.5.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "html2pdf.js": "^0.14.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.7",
    "pdfkit": "^0.18.0",
    "react-markdown": "^10.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@swc/core": "^1.13.3",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/react-query": "^5.84.2",
    "@types/node": "^24.2.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.23.12",
    "globals": "^16.3.0",
    "lucide-react": "^0.539.0",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.62.0",
    "react-resizable-panels": "^3.0.4",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.12.7",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.176.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^8.0.2",
    "vite-plugin-static-copy": "^3.4.0",
    "vitest": "^4.1.0"
  }
}
